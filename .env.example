# DB (docker-compose가 MySQL 컨테이너 생성 시 사용)
DB_ROOT_PASSWORD=root_local_only
DB_PASSWORD=app_local_only
REDIS_PASSWORD=redis_local_only

# JWT 서명 키 (각 32자 이상, HS256). 서비스 간 동일 값 사용
ACCESS_KEY=local-dev-access-key
REFRESH_KEY=local-dev-refresh-key

# 관리자 Seed 계정 (identity 기동 시 없으면 생성)
ADMIN_EMAIL=admin@carexpo.local
ADMIN_PASSWORD=admin1234!

# 서비스 간 내부 호출(/internal/**) 인증 토큰. 서비스마다 같은 값 공유
SVC_TOKEN_PAYMENT=local_dev_payment_token
SVC_TOKEN_RESERVATION=local_dev_reservation_token
SVC_TOKEN_EXPO=local_dev_expo_token

# 프론트 주소
FRONT_ORIGIN=http://localhost:5173

# 비밀번호 재설정 메일 발송 (identity). log(콘솔 로깅) | smtp
MAIL_PROVIDER=log or smtp
MAIL_USERNAME=(이메일 발송 주체)
MAIL_PASSWORD=(구글 앱 비밀번호)

# 포트원 결제 검증 (payment). 미설정 시 빈 값으로 동작
PORTONE_API_SECRET=포트원_api_키
