# DB (docker-compose가 MySQL 컨테이너 생성 시 사용)
DB_ROOT_PASSWORD=root_local_only
DB_PASSWORD=app_local_only
REDIS_PASSWORD=redis_local_only

# JWT 서명 키 (각 32자 이상, HS256). 서비스 간 동일 값 사용
ACCESS_KEY=local-dev-access-key
REFRESH_KEY=local-dev-refresh-key

# 관리자 Seed 계정 (identity 기동 시 없으면 생성)
ADMIN_EMAIL=admin@carexpo.local
ADMIN_PASSWORD=admin1234!

# 서비스 간 내부 호출(/internal/**) 인증 토큰. 서비스마다 같은 값 공유
SVC_TOKEN_PAYMENT=local_dev_payment_token
SVC_TOKEN_RESERVATION=local_dev_reservation_token
SVC_TOKEN_EXPO=local_dev_expo_token
SVC_TOKEN_REVIEW=local_dev_review_token
SVC_TOKEN_IDENTITY=local_dev_identity_token

# 프론트 주소. 운영은 https://mobility-expo.vercel.app
FRONT_ORIGIN=http://localhost:5173

# 소셜 로그인 OAuth 클라이언트 (identity)
# 각 콘솔의 redirect URI 경로는 /login/oauth2/code/{google|kakao|naver} (호스트는 접속 주소에 맞춤)
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
KAKAO_CLIENT_ID=kakao_client_id
KAKAO_CLIENT_SECRET=kakao_client_secret
NAVER_CLIENT_ID=naver_client_id
NAVER_CLIENT_SECRET=naver_client_secret

# 메일 발송 (identity: 비밀번호 재설정, 이메일 인증 코드 / expo가 identity를 통해 리드 안내 메일). log(콘솔 로깅) | smtp
MAIL_PROVIDER=log
MAIL_USERNAME=(이메일 발송 주체)
MAIL_PASSWORD=(구글 앱 비밀번호)
# 선택. 기본값 smtp.gmail.com / 587
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# Gemini AI (expo: 자연어 차량 검색, 상담 요약, 이메일 초안). 선택. 비어 있으면 AI 호출 없이 폴백 동작
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# 포트원 결제 검증 (payment). 미설정 시 빈 값으로 동작
PORTONE_API_SECRET=포트원_api_키
